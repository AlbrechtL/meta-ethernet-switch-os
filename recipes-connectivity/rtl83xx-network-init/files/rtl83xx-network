#!/bin/sh
### BEGIN INIT INFO
# Provides:          networking
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Bridge the switch front ports into br-lan
### END INIT INFO
#
# Hard-coded until the clixon backend plugin owns the interface configuration.

BRIDGE=br-lan
PORTS="@LAN_PORTS@"
ADDRESS="@LAN_ADDRESS@"

start() {
    ip link set lo up

    # DSA conduit. It carries no address, but has to be up for the user ports
    # to pass traffic.
    ip link set eth0 up

    ip link show "$BRIDGE" >/dev/null 2>&1 || ip link add name "$BRIDGE" type bridge
    for port in $PORTS; do
        if ! ip link show "$port" >/dev/null 2>&1; then
            echo "rtl83xx-network: $port does not exist, skipping"
            continue
        fi
        ip link set "$port" master "$BRIDGE"
        ip link set "$port" up
    done

    ip addr flush dev "$BRIDGE"
    ip addr add "$ADDRESS" dev "$BRIDGE"
    ip link set "$BRIDGE" up
}

stop() {
    ip link show "$BRIDGE" >/dev/null 2>&1 || return 0
    for port in $PORTS; do
        ip link set "$port" nomaster 2>/dev/null
        ip link set "$port" down 2>/dev/null
    done
    ip link delete "$BRIDGE"
}

case "$1" in
    start)
        echo "Configuring $BRIDGE ($ADDRESS)"
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
