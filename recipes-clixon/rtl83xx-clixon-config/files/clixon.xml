<clixon-config xmlns="http://clicon.org/config">
  <!-- Adapted from managed-switch-yang-netconf-cli-docker eth-switch.xml:
       /usr instead of /usr/local, runtime files in /var/run, and RESTCONF
       configured here instead of in the datastore. -->
  <CLICON_CONFIGFILE>/etc/clixon.xml</CLICON_CONFIGFILE>
  <!-- Read non-recursively (*.xml only); holds autocli.xml. -->
  <CLICON_CONFIGDIR>/etc/clixon/eth-switch</CLICON_CONFIGDIR>
  <CLICON_FEATURE>ietf-netconf:startup</CLICON_FEATURE>
  <CLICON_FEATURE>clixon-restconf:allow-auth-none</CLICON_FEATURE>
  <CLICON_YANG_DIR>/usr/share/clixon</CLICON_YANG_DIR>
  <CLICON_YANG_DIR>/usr/share/eth-switch/yang</CLICON_YANG_DIR>
  <CLICON_YANG_MODULE_MAIN>clixon-eth-switch</CLICON_YANG_MODULE_MAIN>
  <CLICON_CLI_MODE>eth-switch</CLICON_CLI_MODE>
  <CLICON_CLI_LINESCROLLING>0</CLICON_CLI_LINESCROLLING>
  <CLICON_CLI_TAB_MODE>0</CLICON_CLI_TAB_MODE>
  <CLICON_CLISPEC_DIR>/usr/lib/eth-switch/clispec</CLICON_CLISPEC_DIR>
  <CLICON_BACKEND_DIR>/usr/lib/eth-switch/backend</CLICON_BACKEND_DIR>
  <CLICON_SOCK>/var/run/eth-switch.sock</CLICON_SOCK>
  <CLICON_SOCK_GROUP>clicon</CLICON_SOCK_GROUP>
  <CLICON_BACKEND_PIDFILE>/var/run/eth-switch.pid</CLICON_BACKEND_PIDFILE>
  <CLICON_XMLDB_DIR>/var/lib/clixon/eth-switch</CLICON_XMLDB_DIR>
  <!-- Nothing survives a reboot of the initramfs yet, so start empty. -->
  <CLICON_STARTUP_MODE>init</CLICON_STARTUP_MODE>
  <!-- RESTCONF. With CLICON_BACKEND_RESTCONF_PROCESS false, clixon_restconf
       is started by /etc/init.d/clixon-restconf and reads the <restconf>
       block below. The reference keeps it in the datastore instead, which
       needs a startup db and therefore persistent storage. -->
  <CLICON_BACKEND_RESTCONF_PROCESS>false</CLICON_BACKEND_RESTCONF_PROCESS>
  <CLICON_RESTCONF_USER>clicon</CLICON_RESTCONF_USER>
  <CLICON_RESTCONF_PRIVILEGES>drop_perm</CLICON_RESTCONF_PRIVILEGES>
  <CLICON_RESTCONF_STARTUP_DONTUPDATE>true</CLICON_RESTCONF_STARTUP_DONTUPDATE>
  <restconf>
    <enable>true</enable>
    <!-- No authentication and no TLS: proof of concept only. -->
    <auth-type>none</auth-type>
    <pretty>true</pretty>
    <socket>
      <namespace>default</namespace>
      <address>0.0.0.0</address>
      <port>80</port>
      <ssl>false</ssl>
    </socket>
  </restconf>
</clixon-config>
