@@ -304,6 +304,16 @@ mibyang_table_register(clixon_handle h,
         if (type_yang2asn1(yleaf, &asn1type, 0) < 0)
             //      goto done;
             goto ok; // XXX skip
+        /* A MacAddress index has no length sub-identifier: implied, which
