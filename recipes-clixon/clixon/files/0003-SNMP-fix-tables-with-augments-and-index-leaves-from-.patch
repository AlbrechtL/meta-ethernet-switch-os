+/*! Get the OID of a table column, if the column belongs to a table entry
+ *
+ * A column belongs to the entry if its OID is the entry OID plus one
+ * sub-identifier, and it can be read: index leaves of the entry may be
+ * not-accessible, and index leaves from other tables (leafrefs) have the OIDs
+ * of those tables. Augmented lists hold the columns of several entries.
+ * @param[in]  ys       YANG leaf
+ * @param[in]  oide     OID of table entry
+ * @param[in]  oidelen  Length of table entry OID
+ * @param[out] oidc     Column OID
+ * @param[out] oidclen  Length of column OID
+ * @retval     1        Column of the entry
+ * @retval     0        Not a column of the entry
+ * @retval    -1        Error
+ */
+static int
+snmp_table_column(yang_stmt *ys,
+                  oid       *oide,
+                  size_t     oidelen,
+                  oid       *oidc,
+                  size_t    *oidclen)
+{
+    char *access = NULL;
+    int   ret;
+
+    if (yang_keyword_get(ys) != Y_LEAF)
+        return 0;
+    *oidclen = MAX_OID_LEN; /* capacity: yangext_oid_get overwrites it */
+    if ((ret = yangext_oid_get(ys, oidc, oidclen, NULL)) <= 0)
+        return ret;
+    if (*oidclen != oidelen + 1 ||
+        oid_eq(oidc, oidelen, oide, oidelen) != 0)
+        return 0;
+    if (yang_extension_value_opt(ys, "smiv2:max-access", NULL, &access) < 0)
+        return -1;
+    if (access != NULL &&
+        (strcmp(access, "not-accessible") == 0 ||
+         strcmp(access, "accessible-for-notify") == 0))
+        return 0;
+    return 1;
+}
+
