@@ -1312,9 +1354,7 @@ snmp_table_getnext(clixon_handle               h,
             while ((xcol = xml_child_iter(xrow, &ixcol, CX_ELMNT)) != NULL) {
                 if ((ycol = xml_spec(xcol)) == NULL)
