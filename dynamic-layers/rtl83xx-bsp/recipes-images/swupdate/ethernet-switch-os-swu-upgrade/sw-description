software =
{
	version = "@@DISTRO_VERSION@@";
	description = "RTL83xx upgrade: firmware only, data partition kept";

	/*
	 * Revision field of /etc/hwrevision, unique per board, so that a board
	 * refuses another board's firmware. See ethernet-switch-os-boards.inc.
	 */
	hardware-compatibility: [ "@@ETHERNET_SWITCH_OS_HW_COMPAT@@" ];

	/* No writes to the U-Boot environment, see the factory sw-description. */
	bootloader_transaction_marker = false;
	bootloader_state_marker = false;

	ethernet-switch-os = {
		upgrade = {
			images: (
				{
					filename = "rtl83xx-image-@@MACHINE@@.rootfs.rtl83xx-fw";
					type = "flash";
					mtdname = "firmware";
					sha256 = "$swupdate_get_sha256(rtl83xx-image-@@MACHINE@@.rootfs.rtl83xx-fw)";
				}
			);
		};
	};
}
