# Chooses the SWUpdate software set and, on the flash system, runs SWUpdate
# from RAM.
#
# Sourced by /usr/lib/swupdate/swupdate.sh after 10-mongoose-args, so
# SWUPDATE_WEBSERVER_ARGS already holds "-r /www ${SWUPDATE_MONGOOSE_EXTRA_ARGS}".
#
#   TFTP initramfs  ethernet-switch-os,factory  writes "firmware", wipes "data"
#   flash system    ethernet-switch-os,upgrade  writes "firmware", keeps "data"
#
# Uploading the other kind of .swu fails with "no software set found".

if ! grep -q '^overlay / overlay ' /proc/mounts; then
    # SWUpdate never reboots on its own: "reboot_enabled" only makes the web UI
    # say "Restarting system." and run the -p command. Without -p nothing
    # happens. The initramfs lives in RAM, so a regular reboot is fine here.
    SWUPDATE_ARGS="$SWUPDATE_ARGS -e ethernet-switch-os,factory -p /sbin/reboot"
else
    # An upgrade overwrites the squashfs that swupdate, its libraries and the
    # web UI are loaded from, and the kernel may drop and re-read those pages
    # at any time. Copy everything into tmpfs and start swupdate through the
    # copied musl loader, so that no page it touches is backed by "firmware".
    ram=/run/swupdate-ram
    loader=$(echo /lib/ld-musl-*.so.1)
    ramloader=$ram/lib/${loader##*/}
    # /bin/sh and the loader are symlinks; bind mounts go on the files behind.
    busybox=$(readlink -f /bin/sh)
    libc=$(readlink -f $loader)

    # A restart of the daemon finds the bind mounts of the previous run.
    umount -l $busybox $libc 2>/dev/null

    rm -rf $ram
    mkdir -p $ram/lib
    for lib in $loader $($loader --list /usr/bin/swupdate | awk '$2 == "=>" { print $3 }'); do
        cp -L $lib $ram/lib/
    done
    cp /usr/bin/swupdate $ram/swupdate
    cp -L $busybox $ram/busybox
    cp -a /www $ram/www

    # swupdate runs -p as execl("/bin/sh", "sh", "-c", cmd), i.e. through the
    # squashfs busybox and musl loader. Bind the identical RAM copies over both,
    # so that the shell and the reboot it starts are RAM-backed as well. -f
    # because a regular reboot would signal init, which still runs from flash.
    mount --bind $ram/busybox $busybox
    mount --bind $ramloader $libc

    # The web server calls -p synchronously and only forwards the final DONE
    # status ("Restarting system.") once -p has returned, so rebooting inside -p
    # cuts the browser off without a word. Instead -p detaches a job (setsid,
    # output to /dev/null so swupdate does not wait on its pipes) and returns.
    # The job leaves time for DONE to go out, then stops swupdate ($$ is the pid
    # swupdate.sh execs into) so the websocket closes cleanly and the page shows
    # its restart dialog and polls until the switch is back, then reboots.
    reboot_job="$busybox sleep 2; kill $$; $busybox sleep 2; $busybox sync; $busybox reboot -f"

    exec $ramloader --library-path $ram/lib $ram/swupdate \
        $SWUPDATE_ARGS -e ethernet-switch-os,upgrade \
        -w "-r $ram/www ${SWUPDATE_MONGOOSE_EXTRA_ARGS}" \
        -p "$busybox setsid $busybox sh -c '$reboot_job' </dev/null >/dev/null 2>&1 &"
fi
