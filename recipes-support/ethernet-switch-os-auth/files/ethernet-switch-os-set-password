#!/bin/sh
# Sets the password of the admin account "cli", for SSH, the serial console
# and the web interface.
#
#   ethernet-switch-os-set-password [cli]
#
# Reads the new password from stdin, one line. On a terminal it asks twice,
# without echo. clixon-switch's set-password RPC runs this after checking the
# current password; root on the serial console runs it to regain access
# without a factory reset.
#
# /etc/shadow holds the password. lighttpd checks the web login against
# /etc/lighttpd/htpasswd, which gets a copy of the same hash here, so the two
# never differ. The first successful run ends the first-login setup.

set -e

ADMIN=cli
SETUP_FLAG=/etc/ethernet-switch-os/setup-required
HTPASSWD=/etc/lighttpd/htpasswd
MIN_LEN=8
MAX_LEN=128

user=${1:-$ADMIN}
if [ "$user" != "$ADMIN" ]; then
    echo "only the admin account $ADMIN has a password" >&2
    exit 1
fi

if [ -t 0 ]; then
    trap 'stty echo' EXIT
    stty -echo
    printf 'New password for %s: ' "$user"
    IFS= read -r password
    printf '\nRepeat new password: '
    IFS= read -r repeat
    printf '\n'
    stty echo
    trap - EXIT
    if [ "$password" != "$repeat" ]; then
        echo "The passwords do not match." >&2
        exit 1
    fi
else
    IFS= read -r password || [ -n "$password" ]
fi

if [ ${#password} -lt $MIN_LEN ] || [ ${#password} -gt $MAX_LEN ]; then
    echo "the password must have $MIN_LEN to $MAX_LEN characters" >&2
    exit 1
fi

# bcrypt, with the cost from BCRYPT_MIN_ROUNDS in /etc/login.defs.
printf '%s:%s\n' "$user" "$password" | chpasswd -c BCRYPT
password=

# The web login: the hash chpasswd just wrote. Readable by lighttpd only,
# which runs as the lighttpd user.
hash=$(awk -F: -v u="$user" '$1 == u { print $2 }' /etc/shadow)
tmp=$(mktemp "$HTPASSWD.XXXXXX")
printf '%s:%s\n' "$user" "$hash" > "$tmp"
chgrp lighttpd "$tmp"
chmod 0640 "$tmp"
mv "$tmp" "$HTPASSWD"

rm -f "$SETUP_FLAG"
logger -t set-password "password of $user changed"

# lighttpd caches checked logins (auth.cache): restart it, so that the old
# password stops working for the web at once. In the background: the web
# interface's own request for this is still on its way back through lighttpd,
# which the init script lets finish (graceful stop).
if [ -x /etc/init.d/lighttpd ] && [ -s /run/lighttpd.pid ]; then
    setsid /etc/init.d/lighttpd restart </dev/null >/dev/null 2>&1 &
fi
