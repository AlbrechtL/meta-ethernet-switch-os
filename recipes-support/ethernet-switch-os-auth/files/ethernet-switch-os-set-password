#!/bin/sh
# Creates the admin account, or sets its password, for SSH, the serial
# console and the web interface.
#
#   ethernet-switch-os-set-password --username NAME    the first-login setup
#   ethernet-switch-os-set-password                    a new password
#
# A fresh switch has no admin account. While the setup is pending
# (/etc/ethernet-switch-os/setup-required), --username is required: it
# creates the account NAME with UID 1000. Afterwards the admin account is
# whichever user has UID 1000, and only its password can change; the name
# stays until a factory reset.
#
# Reads the new password from stdin, one line. On a terminal it asks for the
# username (if not given) and twice for the password, without echo.
# clixon-switch's set-password RPC runs this after checking the request;
# root on the serial console runs it to set the switch up or to regain
# access without a factory reset.
#
# /etc/shadow holds the password. lighttpd checks the web login against
# /etc/lighttpd/htpasswd, which gets a copy of the same hash here, so the two
# never differ. The first successful run ends the first-login setup.

set -e

ADMIN_UID=1000
SHELL_PATH=/usr/bin/ethernet-switch-os-cli
SETUP_FLAG=/etc/ethernet-switch-os/setup-required
HTPASSWD=/etc/lighttpd/htpasswd
MIN_LEN=8
MAX_LEN=128
MAX_NAME_LEN=32

die() {
    echo "$*" >&2
    exit 1
}

# A lower case letter or _, then lower case letters, digits, _ and -: what
# useradd, login, dropbear and htpasswd all take. clixon-switch checks the
# same (switch_net::account::validate_username).
valid_username() {
    [ ${#1} -ge 1 ] && [ ${#1} -le $MAX_NAME_LEN ] || return 1
    case $1 in
        [!a-z_]* | *[!a-z0-9_-]*) return 1 ;;
    esac
}

name_taken() {
    awk -F: -v n="$1" '$1 == n { found = 1 } END { exit !found }' /etc/passwd /etc/group
}

admin_name() {
    awk -F: -v uid=$ADMIN_UID '$3 == uid { print $1; exit }' /etc/passwd
}

username=
case "$1" in
    --username)
        [ $# -eq 2 ] || die "usage: $0 [--username NAME]"
        username=$2
        ;;
    "")
        ;;
    *)
        die "usage: $0 [--username NAME]"
        ;;
esac

if [ -e "$SETUP_FLAG" ]; then
    if [ -z "$username" ] && [ -t 0 ]; then
        printf 'Username of the admin account: '
        IFS= read -r username
    fi
    [ -n "$username" ] || die "the username of the admin account is required"
    valid_username "$username" ||
        die "the username must start with a lower case letter or _, followed by at most $((MAX_NAME_LEN - 1)) lower case letters, digits, _ or -"
    ! name_taken "$username" || die "the name $username is taken by a system account"
    [ -z "$(admin_name)" ] || die "there is an account with UID $ADMIN_UID already: $(admin_name)"
    user=$username
else
    [ -z "$username" ] ||
        die "the admin account exists: its username is chosen once, during the setup, and stays until a factory reset"
    user=$(admin_name)
    [ -n "$user" ] || die "there is no admin account (UID $ADMIN_UID)"
fi

if [ -t 0 ]; then
    trap 'stty echo' EXIT
    stty -echo
    printf 'New password for %s: ' "$user"
    IFS= read -r password
    printf '\nRepeat new password: '
    IFS= read -r repeat
    printf '\n'
    stty echo
    trap - EXIT
    if [ "$password" != "$repeat" ]; then
        die "The passwords do not match."
    fi
else
    IFS= read -r password || [ -n "$password" ]
fi

if [ ${#password} -lt $MIN_LEN ] || [ ${#password} -gt $MAX_LEN ]; then
    die "the password must have $MIN_LEN to $MAX_LEN characters"
fi

# The setup: the account, without a password yet ("!" in /etc/shadow). The
# clicon group grants access to clixon's backend socket; users as the
# primary group, so that there is no group of the same name. Should a later
# step fail, the account goes again and the setup stays pending.
if [ -n "$username" ]; then
    useradd -u $ADMIN_UID -N -g users -G clicon -m -d "/home/$user" \
        -s "$SHELL_PATH" "$user"
    trap 'userdel -r "$user" 2>/dev/null' EXIT
fi

# bcrypt, with the cost from BCRYPT_MIN_ROUNDS in /etc/login.defs.
printf '%s:%s\n' "$user" "$password" | chpasswd -c BCRYPT
password=

# The web login: the hash chpasswd just wrote. Readable by lighttpd only,
# which runs as the lighttpd user.
hash=$(awk -F: -v u="$user" '$1 == u { print $2 }' /etc/shadow)
tmp=$(mktemp "$HTPASSWD.XXXXXX")
printf '%s:%s\n' "$user" "$hash" > "$tmp"
chgrp lighttpd "$tmp"
chmod 0640 "$tmp"
mv "$tmp" "$HTPASSWD"

rm -f "$SETUP_FLAG"
trap - EXIT
if [ -n "$username" ]; then
    logger -t set-password "admin account $user created"
else
    logger -t set-password "password of $user changed"
fi

# lighttpd caches checked logins (auth.cache): restart it, so that the old
# password stops working for the web at once. In the background: the web
# interface's own request for this is still on its way back through
# lighttpd, which the init script lets finish (graceful stop).
if [ -x /etc/init.d/lighttpd ] && [ -s /run/lighttpd.pid ]; then
    setsid /etc/init.d/lighttpd restart </dev/null >/dev/null 2>&1 &
fi
