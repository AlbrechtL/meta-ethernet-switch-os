#!/bin/sh
# Login shell of the admin account: a joke, then the clixon CLI.
#
# The account only exists once the first-login setup in the web interface
# has created it (ethernet-switch-os-auth), so there is nothing to set up
# here.
#
# The joke only comes with an interactive login. "ssh NAME@host <command>"
# makes dropbear run "<shell> -c <command>", which passes through unchanged.

if [ $# -eq 0 ] && [ -t 0 ] && [ -x /usr/bin/ethernet-switch-os-joke ]; then
    /usr/bin/ethernet-switch-os-joke
fi
exec /usr/bin/clixon_cli "$@"
